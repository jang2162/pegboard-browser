From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Pegboard <noreply@pegboard.invalid>
Date: Mon, 23 Nov 2026 00:00:00 +0000
Subject: [PATCH] branding.patch

Names the app Pegboard (design F9): app, framework and helper names, the
application menu, bundle ID app.pegboard.browser, the default user data
directory ~/Library/Application Support/Pegboard, and a temporary icon.

Upstream files:
- chrome/app/theme/chromium/BRANDING: product names and bundle ID. The
  app, framework and helper bundle names follow PRODUCT_FULLNAME.
- chrome/app/chromium_strings.grd: IDS_PRODUCT_NAME and
  IDS_SHORT_PRODUCT_NAME (menu items such as "Quit Pegboard").
- chrome/common/chrome_paths_mac.mm: the user data directory name.
- chrome/BUILD.gn: the bundle takes app.icns and Assets.car from
  //pegboard/branding/mac (apply.sh copies browser/branding there).
---
 chrome/BUILD.gn                    | 4 ++--
 chrome/app/chromium_strings.grd    | 4 ++--
 chrome/app/theme/chromium/BRANDING | 6 +++---
 chrome/common/chrome_paths_mac.mm  | 2 +-
 4 files changed, 8 insertions(+), 8 deletions(-)

diff --git a/chrome/BUILD.gn b/chrome/BUILD.gn
index d98c86e5da..f04f4d39b9 100644
--- a/chrome/BUILD.gn
+++ b/chrome/BUILD.gn
@@ -670,12 +670,12 @@ if (is_win) {
   }
 
   bundle_data("chrome_app_icon") {
-    sources = [ "app/theme/$branding_path_component/mac/app.icns" ]
+    sources = [ "//pegboard/branding/mac/app.icns" ]
     outputs = [ "{{bundle_resources_dir}}/{{source_file_part}}" ]
   }
 
   bundle_data("chrome_asset_catalog") {
-    sources = [ "app/theme/$branding_path_component/mac/Assets.car" ]
+    sources = [ "//pegboard/branding/mac/Assets.car" ]
     outputs = [ "{{bundle_resources_dir}}/{{source_file_part}}" ]
   }
 
diff --git a/chrome/app/chromium_strings.grd b/chrome/app/chromium_strings.grd
index 3de8ca69c9..0e7341d3fc 100644
--- a/chrome/app/chromium_strings.grd
+++ b/chrome/app/chromium_strings.grd
@@ -294,10 +294,10 @@ If you update this file, be sure also to update google_chrome_strings.grd. -->
         </then>
         <else>
           <message name="IDS_PRODUCT_NAME" desc="The Chrome application name" translateable="false">
-            Chromium
+            Pegboard
           </message>
           <message name="IDS_SHORT_PRODUCT_NAME" desc="The Chrome application short name." translateable="false">
-            Chromium
+            Pegboard
           </message>
         </else>
       </if>
diff --git a/chrome/app/theme/chromium/BRANDING b/chrome/app/theme/chromium/BRANDING
index f8363d5b29..aba9b1e52b 100644
--- a/chrome/app/theme/chromium/BRANDING
+++ b/chrome/app/theme/chromium/BRANDING
@@ -1,10 +1,10 @@
 COMPANY_FULLNAME=The Chromium Authors
 COMPANY_SHORTNAME=The Chromium Authors
-PRODUCT_FULLNAME=Chromium
-PRODUCT_SHORTNAME=Chromium
+PRODUCT_FULLNAME=Pegboard
+PRODUCT_SHORTNAME=Pegboard
 PRODUCT_INSTALLER_FULLNAME=Chromium Installer
 PRODUCT_INSTALLER_SHORTNAME=Chromium Installer
 COPYRIGHT=Copyright @LASTCHANGE_YEAR@ The Chromium Authors. All rights reserved.
-MAC_BUNDLE_ID=org.chromium.Chromium
+MAC_BUNDLE_ID=app.pegboard.browser
 MAC_CREATOR_CODE=Cr24
 MAC_TEAM_ID=
diff --git a/chrome/common/chrome_paths_mac.mm b/chrome/common/chrome_paths_mac.mm
index 6829c9cb92..7d594b46c5 100644
--- a/chrome/common/chrome_paths_mac.mm
+++ b/chrome/common/chrome_paths_mac.mm
@@ -37,7 +37,7 @@
 #elif BUILDFLAG(GOOGLE_CHROME_BRANDING)
       product_dir_name = "Google/Chrome";
 #else
-      product_dir_name = "Chromium";
+      product_dir_name = "Pegboard";
 #endif
     }
 
