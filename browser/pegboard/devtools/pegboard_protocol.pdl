# Pegboard's own DevTools domain. chrome/browser/devtools/BUILD.gn appends this
# file to Chrome's protocol (as it does cros_protocol.pdl on ChromeOS), and
# inspector_protocol_config.json generates chrome/browser/devtools/protocol/
# pegboard.{h,cc} from it. The handler is //pegboard/devtools/pegboard_handler.
#
# The domain exists only on browser sessions of the DevTools pipe client
# (--remote-debugging-pipe: pegboardd), its own and those opened on it with
# Target.attachToBrowserTarget; not for chrome.debugger, the remote debugging
# port, the DevTools front end, page sessions or a page's
# Target.exposeDevToolsProtocol binding. There it is only for the one session
# that called claim; every other session gets -32601 as for an unknown method
# (-32602 when the parameters are malformed: they are checked first).
# Every method refuses (-32000) a browser context, tab or group that is not an
# agent profile's: a profile whose directory is exactly "PegboardAgent" or
# starts with "PegboardAgent-". A target is a tab's page target ID, a group an
# integer this domain hands out.

version
  major 1
  minor 0

experimental domain Pegboard

  # One line of a confirmation: a label and its value.
  type ConfirmationDetail extends object
    properties
      string label
      string value

  type ProfileInfo extends object
    properties
      string profileDirectory
      string browserContextId
      # Whether the directory name makes it an agent profile.
      boolean isAgent

  # Makes this session the domain's owner. Fails with "already claimed" when
  # another session owns it; the owner going frees it.
  command claim

  # The loaded profiles (not incognito, guest or system ones).
  command getProfiles
    returns
      array of ProfileInfo profiles

  # Loads the agent profile (making it when it does not exist) and opens a
  # window of it unless one is open. No first-run UI.
  command openProfileWindow
    parameters
      string profileDirectory
    returns
      string browserContextId

  # Opens a background about:blank tab in the profile and starts a group with
  # it.
  command createGroup
    parameters
      string browserContextId
      string title
      # grey, blue, red, yellow, green, pink, purple, cyan or orange.
      string color
    returns
      integer groupId
      string targetId

  # Opens a background tab in the group. When the group is gone, the tab
  # starts a new one with this title and color, returned as newGroupId. URLs:
  # about:blank, absolute http:, https: and data: ones.
  command createTab
    parameters
      string browserContextId
      integer groupId
      string url
      string title
      string color
    returns
      string targetId
      optional integer newGroupId

  command addToGroup
    parameters
      integer groupId
      string targetId

  # The group's tabs; none for a group that is gone.
  command getGroupMembers
    parameters
      integer groupId
    returns
      array of string targetIds

  command closeTargets
    parameters
      array of string targetIds

  # Takes these tabs out of whatever group each is in.
  command ungroupTargets
    parameters
      array of string targetIds

  # Takes every tab out of the group (which then is gone).
  command ungroup
    parameters
      integer groupId

  # Asks a person, in a dialog of the browser's own UI on an agent profile's
  # window, whether a command may run. Answers once the dialog is up (or
  # queued behind another one of that window); the person's answer comes as
  # confirmationAnswered. The window is that of the first of targetIds whose
  # window is not closing, else the profile's most recently active window.
  # Refused (-32000): a context or a tab that is not this agent profile's,
  # profileDirectory not the context's, a confirmId that is not 32 lowercase
  # hexadecimal digits or one already open, actionClass other than upload or
  # state, more than 40 details, a label over 40 or a value over 1000
  # characters, 16 confirmations open, or no window. A dialog closes on its
  # own (without an event) 75 s after it was asked for, and when the session
  # owning the domain goes.
  command requestConfirmation
    parameters
      string confirmId
      string browserContextId
      # The session's tabs, the one the command acts on first.
      array of string targetIds
      string sessionId
      string sessionName
      string profileDirectory
      string actionClass
      array of ConfirmationDetail details
      boolean offerAllowForSession

  # Closes the dialog without an answer. Succeeds for one that is gone.
  command cancelConfirmation
    parameters
      string confirmId

  # A person answered, or the dialog closed some other way than
  # cancelConfirmation (its window or tab closing: deny). Once per confirmId.
  event confirmationAnswered
    parameters
      string confirmId
      # approve, deny or allowForSession.
      string answer

  # An agent profile's tab became the active one of its window.
  event tabActivated
    parameters
      string browserContextId
      string targetId
      # Milliseconds since the Unix epoch.
      number timestamp

  event profileLoaded
    parameters
      string profileDirectory
      string browserContextId

  event profileUnloaded
    parameters
      string profileDirectory
      string browserContextId
