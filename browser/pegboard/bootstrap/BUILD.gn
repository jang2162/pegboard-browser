# Starts pegboardd from the browser and hands it the DevTools pipe
# (daemon_launcher.h). //pegboard/browser_parts, which Chrome's main parts
# create (pegboard-bootstrap.patch), runs the launcher; content's pipe handler
# takes the browser's ends (devtools-pipe-fds.patch).

source_set("bootstrap") {
  visibility = [ "//pegboard/browser_parts:*" ]
  sources = [
    "daemon_launcher.cc",
    "daemon_launcher.h",
  ]

  # Like //pegboard/devtools, this uses a //chrome/browser header
  # (chrome_browser_main_extra_parts.h) without depending on //chrome/browser,
  # which depends on it.
  check_includes = false
  deps = [
    "//base",
    "//content/public/browser",
    "//content/public/common",
    "//pegboard/ui",
  ]
}
