# The build for people (browser/scripts/build.sh <src> release -> out/Release). Every argument line
# is the same as args.gn except pegboard_test_hooks (test_release_args.sh checks this).
is_debug = false
symbol_level = 0
is_component_build = false
target_cpu = "arm64"
chrome_pgo_phase = 0
google_api_key = ""
google_default_client_id = ""
google_default_client_secret = ""
# Chromium-branded builds otherwise apply testing/variations/fieldtrial_testing_config.json,
# which turns on experiments such as AperitifHelpers (its helpers fail to start their sandbox
# here, so the network service never runs). Ship the default feature state, as Chrome does.
disable_fieldtrial_testing_config = true
# Non-official Chromium builds turn DCHECKs on by default. A failed DCHECK aborts the whole
# browser, the human's tabs included. Chrome as shipped runs without them.
dcheck_always_on = false
# The browser's own test hooks (//pegboard/ui/test_hooks.gni) are compiled out: PEGBOARD_TEST_HOOKS
# in the browser's environment changes nothing, so no dialog can be answered automatically.
pegboard_test_hooks = false
